{
  "name": "remotion-actions-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated Remotion render smoke test running in GitHub Actions",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts RemotionSmoke out/remotion-smoke.mp4 --codec=h264 --concurrency=2",
    "verify": "node scripts/verify-render.mjs out/remotion-smoke.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "remotion": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}

# Copy to .env and load in your deployment environment, never commit live secrets.
PORT=3100
HOST=127.0.0.1
DATA_DIR=.local-data
ADMIN_KEY=replace-with-32-characters-of-random-data
WORKER_KEY=replace-with-another-32-characters
# Must point to reachable HTTPS backend for Github runner delivery.
FACTORY_PUBLIC_URL=https://factory.example.com
GITHUB_REPO=Zatoot89/Web-dev-mini-projects
GITHUB_REF=main
# GitHub fine-grained token: Actions workflow write permission, only this repo.
GITHUB_TOKEN=
# Pilot merchants must be explicitly approved to prevent arbitrary outbound requests.
ALLOWED_MERCHANT_HOSTS=noon.com,amazon.ae,skullcandy.com,myshopify.com
ALLOWED_ASSET_HOSTS=f.nooncdn.com,skullcandy.com,cdn.shopify.com,images.unsplash.com

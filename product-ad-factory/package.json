{
  "name": "product-ad-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "dev": "node --watch app/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "render:demo": "node scripts/build-demo.mjs && remotion render video/index.tsx ProductAd out/demo.mp4 --codec=h264 --concurrency=2 --crf=21 --props=out/demo-props.json",
    "verify:demo": "node scripts/verify-video.mjs out/demo.mp4",
    "render:job": "remotion render video/index.tsx ProductAd out/product-ad.mp4 --codec=h264 --concurrency=2 --crf=19 --props=out/job-props.json",
    "verify:job": "node scripts/verify-video.mjs out/product-ad.mp4",
    "worker:prepare": "node scripts/prepare-worker.mjs",
    "lint": "node --check app/server.mjs && node --check app/product-url.mjs && node --check app/db.mjs && node --check app/pricing.mjs && node --check scripts/prepare-worker.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.2.0",
    "@remotion/cli": "4.0.542",
    "better-sqlite3": "12.4.1",
    "fastify": "5.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
